# Database connection string — set this to your PostgreSQL database URL
# Example: postgresql://postgres:your_password@localhost:5432/noluforge?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/noluforge?schema=public"

# API server port (optional, defaults to 3001)
PORT=3001

# Frontend URL for CORS (optional, defaults to http://localhost:5173)
FRONTEND_URL=http://localhost:5173
