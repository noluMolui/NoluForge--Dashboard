generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id             String        @id @default(cuid())
  businessName   String
  contactInfo    String
  projectType    String
  previewLink    String
  status         String        @default("Concept / In Progress")
  quoteAmount    Float         @default(0)
  amountPaid     Float         @default(0)
  progress       Int           @default(0)
  depositPercent Int           @default(30)
  lastOutreach   String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  events         ProjectEvent[]
  payments       Payment[]
  outreachLogs   OutreachLog[]
}

model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  type      String
  text      String
  metadata  String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(cuid())
  projectId String
  kind      String
  amount    Float
  reference String?
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model OutreachLog {
  id        String   @id @default(cuid())
  projectId String
  note      String?
  method    String   @default("phone")
  touchedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
